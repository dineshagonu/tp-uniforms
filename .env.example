# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. Never expose this key in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Razorpay (Dashboard -> Account & Settings -> API Keys) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string

# --- Store rules (rupees) ---
NEXT_PUBLIC_STORE_NAME=T&P Uniforms
SHIPPING_FEE=60
# Orders at or above this amount ship free. 0 = never free.
FREE_SHIPPING_ABOVE=999
COD_ENABLED=true
# Max order value allowed for Cash on Delivery. 0 = no limit.
COD_MAX_AMOUNT=5000

# --- Mobile OTP login (Supabase Send SMS hook -> Indian SMS provider) ---
# Supabase -> Authentication -> Hooks -> Send SMS hook -> "Generate secret" (paste full v1,whsec_... value)
SEND_SMS_HOOK_SECRET=v1,whsec_xxxxxxxxxxxxxxxx
# msg91 or 2factor
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=your-msg91-authkey
# DLT-approved OTP template from MSG91 (must contain ##OTP##)
MSG91_TEMPLATE_ID=your-msg91-otp-template-id
# Only if SMS_PROVIDER=2factor
TWOFACTOR_API_KEY=
TWOFACTOR_TEMPLATE=OTP1

# Login options shown to customers (first = default tab).
# Until SMS/DLT is ready: email,mobile (email+password first)   After SMS is live: mobile,email   (or just one)
NEXT_PUBLIC_LOGIN_METHODS=email,mobile
